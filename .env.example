# Public URL of the site. Used for metadata and to mark the admin cookie Secure when it starts with https.
SITE_URL=http://localhost:3000

# Where content.json and uploads live. Mount this as a volume in Docker (default ./data).
DATA_DIR=./data

# Admin panel at /admin. BOTH are required, otherwise /admin returns 404.
# ADMIN_SECRET signs the session cookie: generate with `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Chat ("Abhishek AI"). Leave LLM_API_KEY empty to run in clearly labelled demo mode (curated FAQ answers).
# Works with any OpenAI-compatible Chat Completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# MCP endpoint at /mcp so an LLM can edit the site. Unset = 404. Generate: openssl rand -hex 32
MCP_TOKEN=

# Vercel only: public Blob store token (content + uploads). Unset = filesystem in DATA_DIR.
BLOB_READ_WRITE_TOKEN=

# MCP generate_image tool (optional). OPENAI_IMAGE_MODEL defaults to gpt-image-1-mini.
OPENAI_API_KEY=
